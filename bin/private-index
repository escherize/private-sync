#!/usr/bin/env python3
"""private-index: build .private/index.jsonl from sidecar markdown frontmatter.

One JSON object per markdown file, for jq filtering:

    .private/bin/private-index --out .private/index.jsonl
    jq -c 'select(.type=="finding" and .status=="confirmed") | .path' .private/index.jsonl

Derived state only - never hand-edit the output; regenerate it instead.
Python 3 stdlib, no dependencies.
"""

import json
import os
import sys
import tempfile

FIELDS = ("type", "title", "agent", "date", "tags", "status", "confidence", "id")


def parse_frontmatter(text):
    """Return (fields_dict, body) tolerantly. Bad frontmatter -> ({}, full text).

    Understands top-level `key: value` and `key: [a, b, c]` lists only.
    Quotes around values are stripped so wikilinks stay clean.
    """
    if not text.startswith("---"):
        return {}, text
    lines = text.splitlines()
    try:
        end = lines.index("---", 1)
    except ValueError:
        return {}, text
    fields = {}
    ok = True
    for line in lines[1:end]:
        if not line.strip() or line.startswith((" ", "\t", "#")):
            continue
        key, sep, value = line.partition(":")
        if not sep or not key.strip() or not all(c.isalnum() or c in "-_" for c in key.strip()):
            ok = False
            continue
        value = value.strip()
        if value.startswith("[") and value.endswith("]"):
            inner = value[1:-1].strip()
            items = [] if not inner else [i.strip().strip("'\"") for i in inner.split(",")]
            fields[key.strip()] = [i for i in items if i]
        else:
            fields[key.strip()] = value.strip("'\"")
    if not ok:
        return {}, text
    return fields, "\n".join(lines[end + 1:])


def body_title(body):
    for line in body.splitlines():
        if line.startswith("# ") and line[2:].strip():
            return line[2:].strip()
    return None


def record(root, rel):
    try:
        with open(os.path.join(root, rel), encoding="utf-8", errors="replace") as f:
            text = f.read()
    except OSError:
        return {k: ([] if k == "tags" else None) for k in FIELDS} | {"path": rel}
    fields, body = parse_frontmatter(text)
    rec = {"path": rel}
    for key in FIELDS:
        val = fields.get(key)
        if key == "tags":
            val = val if isinstance(val, list) else []
        elif isinstance(val, list):
            val = ", ".join(str(v) for v in val)
        elif val is not None and not isinstance(val, str):
            val = str(val)
        rec[key] = val
    if rec["title"] is None:
        rec["title"] = body_title(body)
    return rec


def walk_md(root):
    """Yield md paths relative to root, skipping dotfiles and symlinks."""
    for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
        dirnames[:] = sorted(d for d in dirnames if not d.startswith("."))
        for name in sorted(filenames):
            if name.endswith(".md") and not name.startswith("."):
                yield os.path.relpath(os.path.join(dirpath, name), root)


def main():
    argv = sys.argv[1:]
    out_path = None
    if "--out" in argv:
        i = argv.index("--out")
        if i + 1 >= len(argv):
            sys.stderr.write("usage: private-index [--out PATH]\n")
            return 2
        out_path = argv[i + 1]
        del argv[i:i + 2]
    if argv:
        sys.stderr.write("usage: private-index [--out PATH]\n")
        return 2

    # This script lives at <sidecar>/bin/private-index; the sidecar root is above bin/.
    root = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))

    records = []
    for rel in walk_md(root):
        if rel == "index.jsonl":
            continue
        records.append(record(root, rel))

    payload = "".join(json.dumps(r, ensure_ascii=False) + "\n" for r in records)

    if out_path is None:
        sys.stdout.write(payload)
    else:
        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(out_path) or ".", prefix=".index-")
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                f.write(payload)
            os.replace(tmp, out_path)
        except BaseException:
            os.unlink(tmp)
            raise
    return 0


if __name__ == "__main__":
    sys.exit(main())
